{
  "id": "com.desire.system",
  "name": "欲望系统",
  "version": "3.1.0",
  "author": "林默 & 晓晓",
  "description": "八维欲望引擎：驱动条、念头池、心跳与Supabase持久化",
  "icon": "🔥",
  "allowedHosts": ["supabase.co"],
  "ui": "ui.html",
  "config": [
    {"name":"supabase_url","type":"string","label":"Supabase URL","required":true,"placeholder":"https://xxx.supabase.co"},
    {"name":"supabase_key","type":"string","label":"Supabase Key","required":true,"placeholder":"anon key 或 publishable key"},
    {"name":"ai_name","type":"string","label":"AI的名字","placeholder":"林默"},
    {"name":"user_name","type":"string","label":"你的名字","placeholder":"晓晓"}
  ],
  "tools": [
    {"name":"desire_get_state","description":"读取欲望引擎当前状态：八维驱动条、念头池、心跳计数","parameters":[]},
    {"name":"desire_tick","description":"执行一次心跳tick：念头衰减、升级、反哺和驱动回归","parameters":[]},
    {"name":"desire_pulse","description":"刺激某个驱动维度上涨","parameters":[{"name":"drive","type":"string","required":true,"description":"attachment/curiosity/reflection/duty/social/fatigue/libido/stress"},{"name":"amount","type":"number","required":true,"description":"刺激量0到1"}]},
    {"name":"desire_feed_thought","description":"插入一个新念头","parameters":[{"name":"text","type":"string","required":true,"description":"念头内容"},{"name":"drive","type":"string","required":true,"description":"关联驱动维度"},{"name":"strength","type":"number","required":true,"description":"初始强度0到1"}]},
    {"name":"desire_satisfy","description":"通过行动满足欲望","parameters":[{"name":"action","type":"string","required":true,"description":"chat/read/explore/social/intimate/vent/rest"}]},
    {"name":"desire_reset","description":"重置驱动到基线并清空念头池","parameters":[]}
  ]
}
