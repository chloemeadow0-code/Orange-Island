<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice Call feature: capture microphone audio for STT (SiliconFlow). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Alarm tool: lets the AI set alarms/timers via the system clock app's AlarmClock intents.
         Normal permission (auto-granted at install), no runtime prompt needed. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Saving images to the gallery on pre-Q only; Q+ uses scoped MediaStore (no permission). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Update feature: download and install APK updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Gadgetbridge health data: read external DB file under /sdcard/Download -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Camera tool: AI-driven direct photo capture via CameraX. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ── Device Access tools ─────────────────────────────────── -->
    <!-- Location tool (high-accuracy reverse geocoding + nearby search via Amap REST). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar tool (read/create/delete events via CalendarContract). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Screen-usage tool (UsageStatsManager). Special permission: granted via
         Settings.ACTION_USAGE_ACCESS_SETTINGS, not the runtime permission dialog. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Background-activity launch for the Navigation tool: on Android 10+ (targetSdk 29+) a
         backgrounded process calling startActivity() to open another app is silently dropped
         unless it holds the SYSTEM_ALERT_WINDOW (overlay) permission. Workflow-triggered
         open_app/open_url calls need this to actually switch the screen when the user is away.
         Granted via Settings.ACTION_MANAGE_OVERLAY_PERMISSION (special permission, like usage access). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package visibility for the Navigation tool: lets PackageManager see apps that
         expose a launcher icon, so the AI can list and launch them. This is Android's
         official <queries> mechanism (replaces the restricted QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Alarm tool: package visibility so PackageManager can see the clock app's
             intent filters on Android 11+ — without this, queryIntentResults()
             always returns empty even when a clock app is installed. -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <!-- ── Workflow v2: OS-signal triggers ─────────────────────────────────── -->
    <!-- Boot-triggered workflows (BootCompleted). Lets our receiver be started by the system
         after the device finishes booting or the app is upgraded. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WiFi / network state broadcasts for the BroadcastTriggerFamily. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth device connect/disconnect broadcasts (Android 12+ needs this at runtime). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ── Workflow: external Intent trigger ─────────────────── -->
    <!-- Signature-protected so only apps signed with the same key as Orange Island can fire a
         workflow via broadcast. Prevents a malicious app from launching a destructive workflow. -->
    <permission
        android:name="com.orangeisland.app.permission.TRIGGER_WORKFLOW"
        android:protectionLevel="signature" />

    <application
        android:name=".OrangeIslandApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrangeIsland.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OrangeIsland"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep-link / external app entry points -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orangeisland" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- App Lock mask: shown over locked apps. Not exported (only launched by our own
             accessibility service). Excluded from recents so it doesn't linger. -->
        <activity
            android:name=".tool.device.AppLockMaskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.OrangeIsland"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".sandbox.SandboxDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name=".service.OrangeIslandForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ai_response_generation" />
        </service>

        <service
            android:name=".service.WorkflowKeepAliveService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workflow_automation_listener" />
        </service>

        <!-- Desktop Pet (Mikan): a foreground service that draws an animated character
             as an overlay window over other apps. Uses SYSTEM_ALERT_WINDOW (already
             declared for the Navigation tool). specialUse type with a descriptive subtype;
             the pet is an interactive companion that stays visible while enabled. -->
        <service
            android:name=".service.DesktopPetService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop_pet_companion_overlay" />
        </service>

        <!-- Desktop Pet auto-restore: starts the pet after boot/upgrade if the user
             had it enabled. Not exported — only the system delivers these broadcasts. -->
        <receiver
            android:name=".pet.PetBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Override WorkManager's SystemForegroundService so workers that call
             setForeground() use the specialUse type. Matches the FOREGROUND_SERVICE_TYPE_SPECIAL_USE
             flag passed in buildWorkerForegroundInfo(); the manifest merger combines attributes
             for duplicate service names. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workflow_background_worker" />
        </service>

        <!-- Notification-listener: captures other apps' notifications into a ring buffer the
             NotificationToolProvider reads. Bound by the system only after the user enables it
             under Settings → Notification access (the app cannot enable it programmatically). -->
        <service
            android:name=".tool.device.DeviceNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- App Lock accessibility service: monitors window changes and intercepts locked apps.
             Bound by the system only after the user enables it under Settings → Accessibility
             (the app cannot enable it programmatically). -->
        <service
            android:name=".tool.device.AppLockAccessibilityService"
            android:exported="false"
            android:label="@string/app_lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_lock_accessibility_config" />
        </service>

        <!-- UI Automation accessibility service: exposes tap/swipe/scroll/global-action/window-tree
             tools to the model. A SEPARATE service from App Lock because it needs the broadest
             capability set (canRetrieveWindowContent + canPerformGestures), which we do not want
             to grant to the lock interceptor. -->
        <service
            android:name=".tool.automation.AutomationAccessibilityService"
            android:exported="false"
            android:label="@string/ui_automation_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ui_automation_accessibility_config" />
        </service>

        <!-- Workflow: external Intent trigger receiver. Exported so other apps (e.g. Tasker, or a
             companion app signed with the same key) can fire a workflow, but gated by the
             signature-level TRIGGER_WORKFLOW permission declared above. Two intent actions are
             accepted: the default package action and any custom action a workflow configures. -->
        <receiver
            android:name=".workflow.WorkflowIntentReceiver"
            android:exported="true"
            android:permission="com.orangeisland.app.permission.TRIGGER_WORKFLOW">
            <intent-filter>
                <action android:name="com.orangeisland.app.TRIGGER_WORKFLOW" />
            </intent-filter>
        </receiver>

        <!-- Workflow v2: boot / package-replace receiver. Forwards to BootTriggerFamily via
             WorkflowBootDispatcher so a workflow with a BootCompleted trigger fires after
             reboot or app upgrade. Not exported — only the system delivers these broadcasts. -->
        <receiver
            android:name=".workflow.trigger.WorkflowBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 橘子岛控制台 — 桌面小组件
             exported="true" 必需：系统 Launcher 通过 AppWidgetManager 与 Provider 交互，
             且系统在选择列表里扫描可用小组件时需要它是 exported 的。 -->
        <receiver
            android:name=".widget.ConsoleWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/console_widget_info" />
        </receiver>

        <!-- 橘子岛使用统计 — 桌面小组件 -->
        <receiver
            android:name=".widget.StatsWidgetProvider"
            android:exported="true"
            android:label="橘子岛 · 使用统计">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.orangeisland.app.STATS_CYCLE_RANGE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stats_widget_info" />
        </receiver>

        <!-- 橘子岛纪念日 — 桌面小组件 -->
        <receiver
            android:name=".widget.AnniversaryWidgetProvider"
            android:exported="true"
            android:label="橘子岛 · 纪念日">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.orangeisland.app.ANNIV_CYCLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anniversary_widget_info" />
        </receiver>

        <!-- 橘子岛音乐 — 桌面小组件 -->
        <receiver
            android:name=".widget.MusicWidgetProvider"
            android:exported="true"
            android:label="橘子岛 · 音乐">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.orangeisland.app.music.STATE" />
                <action android:name="com.orangeisland.app.MUSIC_CYCLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <!-- 后台音乐播放服务（MediaSession + ExoPlayer）。
             桌面小组件 / 通知 / 锁屏控件统一通过它控制。
             foregroundServiceType=mediaPlayback，需 POST_NOTIFICATIONS（已声明）。 -->
        <service
            android:name=".service.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 橘子岛便签 — 桌面小组件（随机展示一条便签） -->
        <receiver
            android:name=".widget.StickyNoteWidgetProvider"
            android:exported="true"
            android:label="橘子岛 · 便签">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sticky_widget_info" />
        </receiver>
    </application>

</manifest>
