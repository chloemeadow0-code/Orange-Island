<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 卡片阴影层 -->
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#12000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 卡片主体：纯白纸张色 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFEFB" />
            <corners android:radius="20dp" />
            <stroke android:width="0.5dp" android:color="#1A3D2F27" />
        </shape>
    </item>
</layer-list>
